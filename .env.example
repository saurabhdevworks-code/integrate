# PostgreSQL local development
POSTGRES_DB=integration_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_password
DB_URL=jdbc:postgresql://localhost:5432/integration_platform
DB_USERNAME=platform
DB_PASSWORD=platform_dev_password

# Authentication (minimum 32 bytes)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_SECONDS=86400

# Credential Vault (AES-256-GCM 32-byte hex string)
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend
VITE_API_BASE_URL=http://localhost:8080
